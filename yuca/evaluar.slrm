#!/bin/bash
# Evaluación en GPU de un modelo fusionado. Desde ~/unison-llm:
#   sbatch evaluar.slrm <carpeta del modelo> <anio|epoca> <carpeta de salida>
#SBATCH --job-name=unison-eval
#SBATCH --account=curso01
#SBATCH --partition=gpu
#SBATCH --gres=gpu:MI210:1
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --time=4:00:00
#SBATCH --output=%x-%j.out

module load python/3.12.3
source ~/venvs/llm/bin/activate
export HF_HOME=$HOME/.cache/huggingface HF_HUB_OFFLINE=1 TOKENIZERS_PARALLELISM=false
echo "Nodo: $(hostname) · $(date) · $1 $2"
srun python evaluar_yuca.py --modelo "$1" --modo "$2" --salida "$3" \
    --prueba datos/test.jsonl --titulares datos/titulares-eval.json --gammas ${GAMMAS:-0 1 2 4}
estado=$?; echo "Fin: $(date) · código $estado"; exit $estado
