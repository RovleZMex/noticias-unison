#!/bin/bash
# Segunda ronda de entrenamiento en Yuca. Se manda desde ~/unison-llm:  sbatch entrenar.slrm [args extra]
#SBATCH --job-name=unison-lora
#SBATCH --account=curso01
#SBATCH --partition=gpu
#SBATCH --gres=gpu:MI210:1
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --time=12:00:00
#SBATCH --output=%x-%j.out

module load python/3.12.3
source ~/venvs/llm/bin/activate
export HF_HOME=$HOME/.cache/huggingface HF_HUB_OFFLINE=1 TOKENIZERS_PARALLELISM=false
echo "Nodo: $(hostname) · $(date)"
rocm-smi --showuse
srun python entrenar_yuca.py --base "$HOME/unison-llm" "$@"
estado=$?; echo "Fin: $(date) · código $estado"; exit $estado
